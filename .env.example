# API Configuration
FOREX_API_PROVIDER=alpha_vantage  # alpha_vantage, demo
FOREX_API_KEY=your_api_key_here
FOREX_API_BASE_URL=https://www.alphavantage.co

# Database
DB_TYPE=sqlite  # sqlite or postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradevision_ai.db
DB_USER=tradevision
DB_PASSWORD=

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Frontend
REACT_APP_API_BASE_URL=http://localhost:3000/api
REACT_APP_WS_URL=ws://localhost:3000
REACT_APP_DEMO_MODE=false

# Features
ENABLE_PAPER_TRADING=true
ENABLE_HISTORY=true
MAX_PREDICTIONS_STORED=10000

# Market Data
DEFAULT_PAIR=EUR/USD
DEFAULT_TIMEFRAME=5m
CANDLE_POLL_INTERVAL=1000  # milliseconds

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
API_KEY_REQUIRED=false

# Demo Mode
USE_DEMO_DATA=false
DEMO_DATA_FILE=./data/demo-data.json
